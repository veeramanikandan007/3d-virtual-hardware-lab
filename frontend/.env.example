# 3D Virtual Hardware Lab - Environment Configuration Template
# Copy this file to .env and insert your actual API keys

# Application Title & Mode
VITE_APP_TITLE=3D Virtual Hardware Lab
VITE_APP_ENV=development

# API Key Placeholder (e.g. for AI Mentor / Voice / Diagnostics services)
VITE_API_KEY=your_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Backend / Microservices Endpoint
VITE_API_BASE_URL=http://localhost:5000/api

# Hardware ESP32 Web Serial Settings
VITE_SERIAL_BAUD_RATE=115200

# Voice Assistant Default Locale (en-IN or ta-IN)
VITE_VOICE_LANGUAGE=en-IN
